# ── SERVEUR & ENVIRONNEMENT ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# ── BASE DE DONNÉES (PostgreSQL / Railway / Local) ───────────────────────
DATABASE_URL="postgres://postgres:password@localhost:5432/coco_db?schema=public"

# ── SÉCURITÉ & AUTHENTIFICATION (JWT) ─────────────────────────────────────
JWT_SECRET="super-secret-jwt-key-change-in-production_coco"
JWT_EXPIRES_IN="7d"

# ── CLOUDINARY (Stockage Médias & Photos Salons) ──────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ── REDIS & BULLMQ (Phase 1 : Socle Temps Réel & Files Asynchrones) ───────
# Option 1 : URL complète (ex: Railway Redis, Upstash, Redis Cloud)
# Format : redis://default:<password>@<host>:<port>
REDIS_URL="redis://localhost:6379"

# Option 2 : Paramètres éclatés (si REDIS_URL n'est pas utilisé)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Activation du tableau de bord de supervision (/admin/queues)
BULL_BOARD_ENABLED=true

# ── NOTIFICATIONS OMNICANAL (Phase 4 : In-App, Push FCM, WhatsApp, SMS) ────
# 1. Firebase Cloud Messaging (Push Notifications Android / iOS)
FCM_SERVER_KEY="your_firebase_server_key"
FCM_PROJECT_ID="coco-salons-firebase"

# 2. Meta WhatsApp Cloud API (Graph API)
WHATSAPP_API_TOKEN="your_meta_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"

# 3. Termii SMS (Passerelle SMS Côte d'Ivoire Orange / MTN / Moov)
TERMII_API_KEY="your_termii_api_key"
TERMII_SENDER_ID="CocoSalons"

